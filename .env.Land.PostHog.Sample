# ===========================================================================
# Land PostHog telemetry configuration. Read by:
#   • Mountain's PostHogPlugin (posthog-rs SDK, Rust backend)
#   • Cocoon's PostHogBridge (posthog-node SDK, extension host)
#   • Wind's PostHogBridge (posthog-node or posthog-js, service layer)
#   • Sky's PostHogBridge (posthog-js, browser webview)
#   • Maintain/Build scripts (curl → PostHog /batch endpoint)
#
# One key across every Element so a single PostHog project sees the whole
# end-to-end session. `$component` property on each event distinguishes the
# source tier. Copy this file to `.env.Land.PostHog` (gitignored) to pin a
# different project or disable capture in specific environments.
# ===========================================================================

# PostHog project key. `phc_` prefix marks it as a public client-side
# key (safe to ship with the binary; not an admin/server token).
#
# The canonical default lives hardcoded in each consumer
# (Mountain build.rs, Cocoon/Wind/Sky PostHogBridge.ts) so a fresh
# clone reports without this file present. Uncomment + set here to
# pin a different project per-environment.
#LAND_POSTHOG_KEY=phc_YourProjectKeyHere

# PostHog region host (EU by default - do not change without also
# migrating the project). US Cloud: https://us.i.posthog.com
#LAND_POSTHOG_HOST=https://eu.i.posthog.com

# Per-element enable switches - useful for debugging rate-limit storms or
# isolating which tier produces noise. Default: all on in debug; all off in
# release (consumers honour their own cfg(debug_assertions) / DEV gate on
# top of this).
LAND_POSTHOG_MOUNTAIN_ENABLED=true
LAND_POSTHOG_COCOON_ENABLED=true
LAND_POSTHOG_WIND_ENABLED=true
LAND_POSTHOG_SKY_ENABLED=true
LAND_POSTHOG_BUILD_ENABLED=true

# Client-side rate limits (Sky only - Mountain/Cocoon/Wind buffer their own).
# Sky's paste from the user log showed "client rate limiting" errors from
# posthog-js's internal limiter; lowering these keeps us under the sampling
# threshold while still surfacing real errors and lifecycle marks.
LAND_POSTHOG_SKY_MAX_EVENTS_PER_SECOND=5
LAND_POSTHOG_SKY_BATCH_WINDOW_MS=3000
LAND_POSTHOG_SKY_BATCH_MAX=20
# Global cap on Sky `$exception` captures per 10 s window. posthog-js's
# CDN `array.js` enforces its own ~10-per-10s limit on the `$exception`
# event-name slot regardless of signature; a boot flurry of unique
# errors (10 different messages × 1 each) was blowing that cap and
# surfacing the "ignored due to client rate limiting" warning. Keeping
# Land's cap under the CDN's ceiling (7/10 s default) eliminates the
# warning while preserving the unique-signature path.
LAND_POSTHOG_SKY_EXCEPTION_GLOBAL_LIMIT=7

# Session-recording + surveys: off by default (debug builds don't need
# them, and they cost bandwidth). Flip per-env if investigating UX.
LAND_POSTHOG_SESSION_RECORDING=false
LAND_POSTHOG_SURVEYS=false

# Distinct-ID seed for a dev session. Set to your GitHub username or any
# stable personal identifier so all four tiers (Mountain / Cocoon / Wind /
# Sky) share one PostHog person across restarts. Without this, Mountain and
# Cocoon fall back to `land-dev-<OS_USER>`, Wind to `land-dev-wind-<OS_USER>`,
# and Sky to a localStorage-persisted `land-dev-sky-<random>`.
# Copy this file to .env.Land.PostHog (gitignored) and fill in your value.
# (CI: `LAND_POSTHOG_DISTINCT_ID=ci-run-${GITHUB_RUN_ID}`)
LAND_POSTHOG_DISTINCT_ID=
