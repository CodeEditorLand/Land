# ===========================================================================
# Land PostHog telemetry configuration. Read by:
#   • Mountain's PostHogPlugin (posthog-rs SDK, Rust backend)
#   • Cocoon's PostHogBridge (posthog-node SDK, extension host)
#   • Wind's PostHogBridge (posthog-node or posthog-js, service layer)
#   • Sky's PostHogBridge (posthog-js, browser webview)
#   • Maintain/Build scripts (curl → PostHog /batch endpoint)
#
# Naming convention: every Land env var is a single-word, action-oriented,
# PascalCase, present-tense verb. No multi-word concat, no LAND_ prefix.
# Copy this file to `.env.Land.PostHog` (gitignored) to override locally.
# ===========================================================================

# PostHog project key. `phc_` prefix marks it as a public client-side key.
# Default lives hardcoded in each consumer; set here to pin a different
# project per environment.
#Authorize=phc_YourProjectKeyHere

# PostHog region endpoint (EU by default).
#Beam=https://eu.i.posthog.com

# Master switch for telemetry across all tiers (Mountain / Cocoon / Wind /
# Sky / Build). Single bool replaces the previous five per-element flags;
# consumers still honour their own cfg(debug_assertions) / DEV gate on top.
Report=true

# Sky-side rate limits. Sky's posthog-js limiter throttles bursts; tuning
# these keeps us under the CDN's sampling threshold without losing real
# errors. Cocoon shares Buffer / Batch with Sky.
Throttle=5
Buffer=3000
Batch=20

# Global cap on Sky `$exception` captures per 10s window. posthog-js's
# CDN `array.js` enforces its own ~10/10s limit on the `$exception`
# event-name slot; keeping Land's cap under that ceiling avoids the
# "ignored due to client rate limiting" warning.
Cap=7

# Session recording + surveys: off by default.
Replay=false
Ask=false

# Distinct-ID seed for a dev session. Stable identifier (e.g. GitHub
# username) so all four tiers share one PostHog person across restarts.
# Without this, each tier falls back to a local OS-user fingerprint.
# CI: Brand=ci-run-${GITHUB_RUN_ID}
Brand=

# ===========================================================================
# OpenTelemetry (dual pipe). Spans land in Jaeger via OTLP; trace_id rides
# every PostHog event so the two pipes join. `Land/Container/Up.sh` brings
# up the local collector.
# ===========================================================================

# OTLP HTTP collector endpoint. Bound to localhost by Compose.yaml.
OTLPEndpoint=http://127.0.0.1:4318

# Independent toggle for the OTLP side; PostHog stays on `Report`.
OTLPEnabled=true

# Master telemetry kill switch. `Capture=false` stops both pipes
# everywhere. Distinct from `.env.Land.Diagnostics`'s `Disable`
# (polyfill / shim kill switch).
Capture=true

# Span / element filter (RUST_LOG-like). `all` = every tier; otherwise
# comma-separated element / tag names: `mountain`, `cocoon`, `sky`, `ipc`,
# `extension-host`, `build`, ...
Trace=all

# Mirror outgoing batches to a per-session NDJSON log under each Element's
# `Target/debug/Telemetry/`. Enable with `Record=1`.
Record=0
