# ===========================================================================
# Land diagnostic overlay - SAMPLE. Copy to `.env.Land.Diagnostics`
# (real file, gitignored) and uncomment the keys you want flipped on.
# `Maintain/Script/TierEnvironment.sh` cascades real > .Sample > absent
# so this file ships as a runnable default for fresh clones.
#
# Single-word, action-oriented, PascalCase verb naming - same rule as
# every other Land env var. See the real `.env.Land.Diagnostics` for
# the canonical comment block per key.
# ===========================================================================

# Auto-open Mountain's WKWebView DevTools at boot. Steals macOS focus.
#Inspect=1

# Run Wind's CommandCatalog smoke harness against the live workbench.
#Smoke=1

# Dev-log tag selection (comma-list, or `all`).
#Trace=all

# Persist Mountain dev-log to <app-data>/logs/<timestamp>/Mountain.dev.log.
#Record=1

# Master kill-switch: skip every Land-specific shim, polyfill, and
# connection attempt (Output transforms, SkyBridge listeners, Cocoon /
# Air spawn, CloseRequested intercept, smoke harness). Useful for
# bisecting whether a regression is in our customisations or upstream
# / Tauri / WKWebView itself. See `.env.Land.Diagnostics` for the full
# list of read sites.
#Disable=true
