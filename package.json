{
	"name": "@codeeditorland/land",
	"version": "0.0.1",
	"private": false,
	"description": "Land 🏞️",
	"homepage": "https://GitHub.Com/CodeEditorLand/Land?tab=readme-ov-file",
	"bugs": {
		"url": "https://GitHub.Com/CodeEditorLand/Land/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CodeEditorLand/Land.git"
	},
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Source 🖋️ Open 👐🏻",
		"email": "Source/Open@Editor.Land",
		"url": "https://Editor.Land"
	},
	"type": "module",
	"scripts": {
	  "Debug": "sh Maintain/Debug.sh",
	  "Dev:Mountain": "sh Maintain/Dev-Mountain.sh",
	  "Dev:Mountain:Wind": "sh Maintain/Dev-Mountain.sh --profile wind",
	  "Dev:Mountain:Electron": "sh Maintain/Dev-Mountain.sh --profile electron",
	  "Release": "sh Maintain/Release.sh",
	  "Run": "turbo run Run --framework-inference=false --no-daemon",
		"build:debug": "./Target/release/Maintain --profile debug -- pnpm tauri build --debug",
		"build:oxc": "./Target/release/Maintain --profile oxc-bundle -- pnpm tauri build",
		"build:production": "./Target/release/Maintain --profile production -- pnpm tauri build",
		"build:release": "./Target/release/Maintain --profile release -- pnpm tauri build",
		"build:swc": "./Target/release/Maintain --profile swc-bundle -- pnpm tauri build",
		"codemod": "node ./node_modules/@turbo/codemod/dist/cli.js",
		"prepare:bundler": "./Target/release/Maintain --profile bundler-preparation -- echo 'Bundler preparation complete'",
		"prepublishOnly": "turbo run prepublishOnly --framework-inference=false --no-daemon"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.15",
		"@ianvs/prettier-plugin-sort-imports": "4.7.1",
		"@playform/build": "0.3.0",
		"@playform/eliminate": "0.0.7",
		"@playform/pipe": "0.1.4",
		"@prettier/plugin-lua": "0.0.3",
		"@prettier/plugin-oxc": "0.1.3",
		"@prettier/plugin-php": "0.24.0",
		"@prettier/plugin-ruby": "4.0.4",
		"@tailwindcss/aspect-ratio": "0.4.2",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.19",
		"@trivago/prettier-plugin-sort-imports": "6.0.2",
		"@turbo/codemod": "2.8.7",
		"@vue/compiler-sfc": "3.5.28",
		"cross-env": "10.1.0",
		"prettier": "3.8.1",
		"prettier-plugin-astro": "0.14.1",
		"prettier-plugin-autocorrect": "0.4.3",
		"prettier-plugin-ember-template-tag": "2.1.3",
		"prettier-plugin-java": "2.8.1",
		"prettier-plugin-kotlin": "2.1.0",
		"prettier-plugin-organize-attributes": "1.0.0",
		"prettier-plugin-packagejson": "3.0.0",
		"prettier-plugin-pkg": "0.21.2",
		"prettier-plugin-sh": "0.18.0",
		"prettier-plugin-sort-imports": "1.8.10",
		"prettier-plugin-sql": "0.19.2",
		"prettier-plugin-svelte": "3.4.1",
		"prettier-plugin-tailwindcss": "0.7.2",
		"prettier-plugin-toml": "2.0.6",
		"tailwindcss": "3.4.17",
		"turbo": "2.8.7",
		"typescript": "5.9.3"
	},
	"packageManager": "pnpm@10.28.2",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@parcel/watcher",
			"@swc/core",
			"esbuild",
			"msgpackr-extract",
			"protobufjs",
			"sharp",
			"workerd"
		],
		"overrides": {
			"@effect/cluster": "*",
			"@effect/rpc": "*",
			"@effect/sql": "*",
			"effect": "*"
		}
	}
}
