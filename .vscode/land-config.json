			"TAURI_ENV_PLATFORM_VERSION": {
				"type": "string",
				"description": "Platform version",
				"config_path": "tauri.platform_version"
			},
			"TAURI_ENV_TARGET_TRIPLE": {
				"type": "string",
				"description": "Target triple (e.g., x86_64-apple-darwin)",
				"config_path": "tauri.target_triple"
			},
			"TAURI_DEV_HOST": {
				"type": "string",
				"description": "Development server host",
				"config_path": "tauri.dev_host"
			},
			"TAURI_DEV_ROOT_CERTIFICATE_PATH": {
				"type": "string",
				"description": "Root certificate path for dev server",
				"config_path": "tauri.dev_cert_path"
			},
			"TAURI_CLI_PORT": {
				"type": "string",
				"description": "Tauri CLI port",
				"default": "3000",
				"config_path": "tauri.cli_port"
			},
			"TAURI_CLI_CONFIG_DEPTH": {
				"type": "string",
				"description": "Config search depth",
				"config_path": "tauri.config_depth"
			},
			"TAURI_CLI_NO_DEV_SERVER_WAIT": {
				"type": "string",
				"description": "Skip dev server wait",
				"config_path": "tauri.no_dev_server_wait"
			},
			"TAURI_CLI_WATCHER_IGNORE_FILENAME": {
				"type": "string",
				"description": "Watcher ignore filename",
				"config_path": "tauri.watcher_ignore_file"
			},
			"TAURI_ANDROID_PROJECT_PATH": {
