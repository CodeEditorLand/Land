{
	/**
	 * Land Configuration - Single Source of Truth
	 *
	 * This file serves as the central configuration for the entire monorepo:
	 * - Build process configuration
	 * - Environment variable management
	 * - Profile-based settings
	 * - Dynamic Rhai script integration
	 * - Workbench configuration
	 * - Feature flags
	 * - Binary configuration
	 *
	 * Supported features:
	 * - Comments (lines starting with // or /**\/ blocks)
	 * - Trailing commas
	 * - Multiple configuration profiles
	 * - Template-based default values
	 * - Environment variable prefixes per crate
	 *
	 * Version history:
	 * v1.2.0 - Added comprehensive environment variable inventory and CLI configuration
	 * v1.1.0 - Added workbench, features, and binary configuration
	 * v1.0.0 - Initial configuration structure
	 */

	"version": "1.2.0",

	/**
	 * Workbench Configuration
	 * Defines available workbenches and their feature sets.
	 */
	"workbench": {
		"default": "Browser",
		"available": [
			"Browser",
			"Mountain",
			"Electron",
			"BrowserProxy"
		],
		"features": {
			"Browser": {
				"description": "Standard web-based VSCode workbench",
				"coverage": "70-80%",
				"complexity": "Low",
				"polyfills": false,
				"mountain_providers": false,
				"wind_services": false,
				"electron_apis": false,
				"recommended_for": [
					"Web deployment",
					"Quick testing",
					"Minimal setup"
				]
			},
			"BrowserProxy": {
				"description": "Browser workbench with Mountain services proxy",
				"coverage": "70-80%",
				"complexity": "Medium",
				"polyfills": false,
				"mountain_providers": true,
				"wind_services": false,
				"electron_apis": false,
				"recommended_for": [
					"Proxy-based deployment",
					"Service delegation"
				]
			},
			"Mountain": {
				"description": "Browser workbench with direct Mountain providers (RECOMMENDED)",
				"coverage": "80-90%",
				"complexity": "Medium",
				"polyfills": true,
				"mountain_providers": true,
				"wind_services": true,
				"electron_apis": false,
				"recommended_for": [
					"Tauri desktop",
					"Production use",
					"Maximum compatibility"
				],
				"recommended": true
			},
			"Electron": {
				"description": "Full Electron workbench with complete polyfills",
				"coverage": "95%+",
				"complexity": "High",
				"polyfills": true,
				"mountain_providers": false,
				"wind_services": true,
				"electron_apis": true,
				"recommended_for": [
					"Maximum VSCode compatibility",
					"Extension support"
				]
			}
		}
	},

	/**
	 * Feature Flags
	 * Global feature toggles that can be enabled/disabled per profile.
	 */
	"features": {
		"tauri_ipc": {
			"description": "Enable Tauri IPC communication",
			"default": true,
			"depends_on": []
		},
		"electron_polyfills": {
			"description": "Enable Electron API polyfills",
			"default": false,
			"depends_on": []
		},
		"wind_services": {
			"description": "Enable Wind service integration",
			"default": true,
			"depends_on": []
		},
		"mountain_providers": {
			"description": "Enable Mountain provider integration",
			"default": true,
			"depends_on": ["wind_services"]
		},
		"vscode_protocols": {
			"description": "Enable VSCode protocol handlers",
			"default": true,
			"depends_on": []
		},
		"webview_panels": {
			"description": "Enable webview panel support",
			"default": true,
			"depends_on": []
		},
		"integrated_terminal": {
			"description": "Enable integrated terminal",
			"default": true,
			"depends_on": ["wind_services"]
		},
		"language_servers": {
			"description": "Enable language server support",
			"default": true,
			"depends_on": []
		},
		"debugger_integration": {
			"description": "Enable debugger integration",
			"default": true,
			"depends_on": ["language_servers"]
		},
		"source_control": {
			"description": "Enable source control integration",
			"default": true,
			"depends_on": []
		},
		"extension_host": {
			"description": "Enable extension host support",
			"default": true,
			"depends_on": []
		},
		"remote_development": {
			"description": "Enable remote development support",
			"default": false,
			"depends_on": []
		}
	},

	/**
	 * Binary Configuration
	 * Settings for binary builds and signing.
	 */
	"binary": {
		"name_template": "{Environment}_{Dependency}_{NodeVersion}_Mountain",
		"identifier_template": "land.editor.binary.{env}.{dependency}.node{version}",
		"version_format": "semver",
		"sign": {
			"macos": {
				"identity": "",
				"entitlements": "./Entitlements.plist",
				"hardened_runtime": true,
				"gatekeeper_assess": false
			},
			"windows": {
				"certificate": "",
				"timestamp_server": "http://timestamp.digicert.com",
				"tsa_can_only_access_urls": []
			},
			"linux": {
				"gpg_key": "",
				"gpg_passphrase_env": "GPG_PASSPHRASE"
			}
		},
		"notarize": {
			"macos": {
				"apple_id": "",
				"password_env": "APPLE_ID_PASSWORD",
				"team_id": ""
			}
		},
		"updater": {
			"enabled": true,
			"endpoints": [
				"https://releases.editor.land/{{target}}/{{arch}}/{{current_version}}"
			],
			"pubkey": ""
		}
	},

	/**
	 * Configuration profiles for different build scenarios.
	 * Each profile contains static environment variables and optional Rhai script references.
	 */
	"profiles": {
		/**
		 * Debug build profile
		 * Optimized for development with verbose logging and source maps
		 */
		"debug": {
			"description": "Debug build profile with full logging and development features",
			"workbench": "Browser",
			"env": {
				"Debug": "true",
				"Browser": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "false",
				"NODE_ENV": "development",
				"NODE_VERSION": "22",
				"NODE_OPTIONS": "--max-old-space-size=16384",
				"RUST_LOG": "debug",
				"AIR_LOG_JSON": "false",
				"AIR_LOG_FILE": "",
				"Level": "silent",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": true,
				"electron_polyfills": false,
				"wind_services": false,
				"mountain_providers": false
			},
			"rhai_script": "scripts/profiles/debug-profile.rhai"
		},

		/**
		 * Debug Mountain Profile (RECOMMENDED)
		 * Debug build with Mountain workbench - recommended for Tauri development
		 */
		"debug-mountain": {
			"description": "Debug build with Mountain workbench (RECOMMENDED for Tauri)",
			"workbench": "Mountain",
			"env": {
				"Debug": "true",
				"Mountain": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "false",
				"NODE_ENV": "development",
				"NODE_VERSION": "22",
				"NODE_OPTIONS": "--max-old-space-size=16384",
				"RUST_LOG": "debug",
				"Level": "silent",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": true,
				"electron_polyfills": true,
				"wind_services": true,
				"mountain_providers": true
			},
			"rhai_script": "scripts/profiles/debug-mountain-profile.rhai"
		},

		/**
		 * Debug Electron Profile
		 * Debug build with Electron workbench for maximum compatibility testing
		 */
		"debug-electron": {
			"description": "Debug build with Electron workbench for full API testing",
			"workbench": "Electron",
			"env": {
				"Debug": "true",
				"Electron": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "false",
				"NODE_ENV": "development",
				"NODE_VERSION": "22",
				"NODE_OPTIONS": "--max-old-space-size=16384",
				"RUST_LOG": "debug",
				"Level": "silent",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": true,
				"electron_polyfills": true,
				"wind_services": true,
				"mountain_providers": false
			},
			"rhai_script": "scripts/profiles/debug-electron-profile.rhai"
		},

		/**
		 * Production build profile
		 * Optimized for release with minimal logging
		 */
		"production": {
			"description": "Production build profile optimized for release deployment",
			"workbench": "Mountain",
			"env": {
				"Debug": "false",
				"Mountain": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "true",
				"NODE_ENV": "production",
				"NODE_VERSION": "22",
				"NODE_OPTIONS": "--max-old-space-size=8192",
				"RUST_LOG": "info",
				"AIR_LOG_JSON": "false",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": true,
				"electron_polyfills": true,
				"wind_services": true,
				"mountain_providers": true
			},
			"rhai_script": "scripts/profiles/production-profile.rhai"
		},

		/**
		 * Release build profile
		 * Complete release with all packaging steps
		 */
		"release": {
			"description": "Release build profile with complete packaging and signing",
			"workbench": "Mountain",
			"env": {
				"Debug": "false",
				"Mountain": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "true",
				"NODE_ENV": "production",
				"NODE_VERSION": "22",
				"NODE_OPTIONS": "--max-old-space-size=8192",
				"RUST_LOG": "warn",
				"AIR_LOG_JSON": "false",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": true,
				"electron_polyfills": true,
				"wind_services": true,
				"mountain_providers": true
			},
			"rhai_script": "scripts/profiles/release-profile.rhai"
		},

		/**
		 * Web Browser Profile
		 * For web-only deployment without Tauri
		 */
		"web-browser": {
			"description": "Web browser deployment profile without Tauri dependencies",
			"workbench": "Browser",
			"env": {
				"Debug": "false",
				"Browser": "true",
				"Bundle": "true",
				"Clean": "true",
				"Compile": "true",
				"NODE_ENV": "production",
				"NODE_VERSION": "22",
				"RUST_LOG": "warn",
				"Dependency": "Microsoft/VSCode"
			},
			"features": {
				"tauri_ipc": false,
				"electron_polyfills": false,
				"wind_services": false,
				"mountain_providers": false
			},
			"rhai_script": "scripts/profiles/web-browser-profile.rhai"
		},

		/**
		 * Bundler Preparation Profile
		 * Sets up environment for SWC or OXC bundler integration
		 */
		"bundler-preparation": {
			"description": "Prepares build system for SWC/OXC bundler integration",
			"workbench": "Browser",
			"env": {
				"BUNDLER_TYPE": "swc",
				"SWC_TARGET": "esnext",
				"SWC_MODULE": "esnext",
				"SWC_SOURCE_MAPS": "true",
				"SWC_MINIFY": "false",
				"SWC_TREE_SHAKING": "true"
			},
			"rhai_script": "scripts/bundler/bundler-preparation.rhai"
		},

		/**
		 * SWC Bundle Profile
		 * Uses SWC (Speedy Web Compiler) for high-performance bundling
		 */
		"swc-bundle": {
			"description": "SWC bundler for ultra-fast compilation and bundling",
			"workbench": "Mountain",
			"env": {
				"BUNDLER_TYPE": "swc",
				"SWC_TARGET": "es2022",
				"SWC_MODULE": "esnext",
				"SWC_SOURCE_MAPS": "true",
				"SWC_MINIFY": "true",
				"SWC_TREE_SHAKING": "true",
				"NODE_ENV": "production",
				"RUST_LOG": "info"
			},
			"rhai_script": "scripts/bundler/swc-bundle.rhai"
		},

		/**
		 * OXC Bundle Profile
		 * Uses OXC (next-generation toolchain by Boshen) for bundling
		 */
		"oxc-bundle": {
			"description": "OXC bundler for next-generation JavaScript toolchain",
			"workbench": "Mountain",
			"env": {
				"BUNDLER_TYPE": "oxc",
				"OXC_TARGET": "es2022",
				"OXC_MODULE": "esmodule",
				"OXC_SOURCE_MAPS": "true",
				"OXC_MINIFY": "true",
				"OXC_TREE_SHAKING": "true",
				"NODE_ENV": "production",
				"RUST_LOG": "info"
			},
			"rhai_script": "scripts/bundler/oxc-bundle.rhai"
		}
	},

	/**
	 * Default template values used across all profiles.
	 * These serve as base values that can be overridden by profile-specific env vars.
	 */
	"templates": {
		"env": {
			"MOUNTAIN_DIR": "Element/Mountain",
			"MOUNTAIN_ORIGINAL_BASE_NAME": "Mountain",
			"MOUNTAIN_BUNDLE_ID_PREFIX": "land.editor.binary",
			"MOUNTAIN_HOST": "localhost",
			"MOUNTAIN_PORT": "50051",
			"MOUNTAIN_CONNECTION_TIMEOUT": "30000",
			"MOUNTAIN_MAX_RETRIES": "3",
			"MOUNTAIN_ENABLE_TLS": "false",
			"MOUNTAIN_HEALTH_CHECK_PERIOD": "30000",
			"AIR_LOG_DIR": "",
			"VSCODE_APP_ROOT": ""
		}
	},

	/**
	 * Environment variable prefixes for each crate/package.
	 * Used to namespace environment variables and avoid conflicts.
	 */
	"env_prefixes": {
		"air": "AIR_",
		"cocoon": "MOUNTAIN_",
		"grove": "VSCODE_",
		"maintain": "LAND_"
	},

	/**
	 * Build command templates.
	 * These are pre-configured command sequences that can be referenced by profiles.
	 */
	"build_commands": {
		"debug": "pnpm tauri build --debug",
		"production": "pnpm tauri build",
		"release": "pnpm tauri build",
		"dev": "pnpm tauri dev",
		"swc-bundle": "pnpm tauri build",
		"oxc-bundle": "pnpm tauri build"
	},

	/**
	 * Environment Variable Inventory
	 * Complete list of all environment variables used across the build system.
	 * This serves as the single source of truth for environment variable management.
	 */
	"environment_variables": {
		/**
		 * Build Flags
		 * Boolean flags that control build behavior.
		 */
		"build_flags": {
			"Browser": {
				"type": "boolean",
				"description": "Enable Browser workbench build",
				"values": ["true", "false"],
				"config_path": "workbench.type.browser"
			},
			"Wind": {
				"type": "boolean",
				"description": "Enable Wind workbench build",
				"values": ["true", "false"],
				"config_path": "workbench.type.wind"
			},
			"Mountain": {
				"type": "boolean",
				"description": "Enable Mountain workbench build (RECOMMENDED)",
				"values": ["true", "false"],
				"config_path": "workbench.type.mountain"
			},
			"Electron": {
				"type": "boolean",
				"description": "Enable Electron workbench build",
				"values": ["true", "false"],
				"config_path": "workbench.type.electron"
			},
			"BrowserProxy": {
				"type": "boolean",
				"description": "Enable Browser workbench with Mountain proxy",
				"values": ["true", "false"],
				"config_path": "workbench.type.browser_proxy"
			},
			"Bundle": {
				"type": "boolean",
				"description": "Enable bundling of distribution packages",
				"values": ["true", "false"],
				"config_path": "build.bundle"
			},
			"Clean": {
				"type": "boolean",
				"description": "Perform clean build (remove artifacts)",
				"values": ["true", "false"],
				"config_path": "build.clean"
			},
			"Compile": {
				"type": "boolean",
				"description": "Enable compilation step",
				"values": ["true", "false"],
				"config_path": "build.compile"
			},
			"Debug": {
				"type": "boolean",
				"description": "Enable debug build mode",
				"values": ["true", "false"],
				"config_path": "build.debug"
			}
		},

		/**
		 * Build Configuration
		 * String values for build configuration.
		 */
		"build_config": {
			"Level": {
				"type": "string",
				"description": "Build output log level",
				"values": ["silent", "info", "debug", "trace"],
				"default": "silent",
				"config_path": "build.log_level"
			},
			"Dependency": {
				"type": "string",
				"description": "Dependency source (org/repo format)",
				"values": [
					"Microsoft/VSCode",
					"tauri-apps/tauri",
					"CodeEditorLand/Editor"
				],
				"default": "Microsoft/VSCode",
				"config_path": "dependency.source"
			}
		},

		/**
		 * Node.js Configuration
		 * Node.js runtime settings.
		 */
		"node": {
			"NODE_ENV": {
				"type": "string",
				"description": "Node.js environment",
				"values": ["development", "production", "test"],
				"default": "development",
				"config_path": "node.environment"
			},
			"NODE_VERSION": {
				"type": "string",
				"description": "Node.js version for sidecar bundling",
				"values": ["22", "20", "18"],
				"default": "22",
				"config_path": "node.version"
			},
			"NODE_OPTIONS": {
				"type": "string",
				"description": "Node.js CLI options",
				"default": "--max-old-space-size=16384",
				"config_path": "node.options"
			}
		},

		/**
		 * Rust Configuration
		 * Rust runtime settings.
		 */
		"rust": {
			"RUST_LOG": {
				"type": "string",
				"description": "Rust logging level",
				"values": ["error", "warn", "info", "debug", "trace"],
				"default": "info",
				"config_path": "rust.log_level"
			},
			"RUST_BACKTRACE": {
				"type": "string",
				"description": "Rust backtrace mode",
				"values": ["0", "1", "full"],
				"default": "0",
				"config_path": "rust.backtrace"
			},
			"MACOSX_DEPLOYMENT_TARGET": {
				"type": "string",
				"description": "macOS deployment target version",
				"default": "10.13",
				"config_path": "rust.macos_deployment_target"
			}
		},

		/**
		 * Mountain/Cocoon Configuration
		 * Mountain binary and service settings.
		 */
		"mountain": {
			"MOUNTAIN_DIR": {
				"type": "string",
				"description": "Mountain project directory",
				"default": "Element/Mountain",
				"config_path": "mountain.directory"
			},
			"MOUNTAIN_ORIGINAL_BASE_NAME": {
				"type": "string",
				"description": "Mountain base name for product naming",
				"default": "Mountain",
				"config_path": "mountain.base_name"
			},
			"MOUNTAIN_BUNDLE_ID_PREFIX": {
				"type": "string",
				"description": "Bundle identifier prefix",
				"default": "land.editor.binary",
				"config_path": "mountain.bundle_prefix"
			},
			"MOUNTAIN_HOST": {
				"type": "string",
				"description": "Mountain gRPC host",
				"default": "localhost",
				"config_path": "mountain.host"
			},
			"MOUNTAIN_PORT": {
				"type": "string",
				"description": "Mountain gRPC port",
				"default": "50051",
				"config_path": "mountain.port"
			},
			"MOUNTAIN_CONNECTION_TIMEOUT": {
				"type": "string",
				"description": "Connection timeout in milliseconds",
				"default": "30000",
				"config_path": "mountain.connection_timeout"
			},
			"MOUNTAIN_MAX_RETRIES": {
				"type": "string",
				"description": "Maximum connection retries",
				"default": "3",
				"config_path": "mountain.max_retries"
			},
			"MOUNTAIN_ENABLE_TLS": {
				"type": "string",
				"description": "Enable TLS for gRPC",
				"default": "false",
				"config_path": "mountain.enable_tls"
			},
			"MOUNTAIN_HEALTH_CHECK_PERIOD": {
				"type": "string",
				"description": "Health check period in milliseconds",
				"default": "30000",
				"config_path": "mountain.health_check_period"
			}
		},

		/**
		 * Tauri Configuration
		 * Tauri-specific environment variables.
		 */
		"tauri": {
			"TAURI_ENV_ARCH": {
				"type": "string",
				"description": "Target architecture",
				"values": ["x86_64", "aarch64", "arm"],
				"config_path": "tauri.arch"
