# ===========================================================================
# Land tier-gating flags. Read by:
#   • Mountain's build.rs (Rust feature activation + rustc-env exposure)
#   • Cocoon's Bootstrap (esbuild `define` substitution)
#   • Wind's vite.config.ts (import.meta.env resolution)
#   • Sky's astro.config.ts (runtime __LandTiers injection)
#
# Every consumer reads this same file - if a tier flips, every Element
# picks up the change. Copy this file to `.env.Land` (gitignored) to
# override per machine. See:
#
#     Documentation/GitHub/Workflow/TierGatedImplementationSelection.md
#
# for the full cross-Element propagation workflow.
#
# ===========================================================================

# Product identity + version (Atom I5, single source of truth) --------------
ProductVersion="1.118.0"
ProductCommit="dev"
ProductQuality="development"
ProductNameShort="FIDDEE"
ProductNameLong="FIDDEE"
ProductApplicationName="fiddee"
ProductDataFolderName=".fiddee"
ProductUrlProtocol="fiddee"
ProductServerApplicationName="fiddee-server"
ProductEmbedderIdentifier="fiddee-desktop"
# ProductFlavor — 10-char build flavor code (≤10 chars after fiddee-).
# Encodes routing decisions as 5 two-char groups.
#   Group 1: IPC mode + WebSocket (IM=IPC Mtn, ID=IPC Node, WD=WS Disabled)
#   Group 2: Tasks + Auth (TM=Tasks Mtn, TN=Tasks Node, AM=Auth Mtn, AN=Auth Node)
#   Group 3: Terminal + SCM + Debug (MM=all Mountain, NN=all Node)
#   Group 4: Search + Language + Output (MM=all Mountain)
#   Group 5: Storage + Model + TreeView + NativeHost + Encryption (MM=all Mtn)
# Set ProductFlavorLong=true to use human-readable names (F8, FR, FN, FC).
ProductFlavor="IWTNMMMMMM"
#ProductFlavorLong=false

# Network ports (override for parallel sessions) ----------------------------
NetworkMountainPort=50051
NetworkCocoonPort=50052

# Transport + communication -------------------------------------------------
TierRemoteProcedureCall=gRPC
TierHTTPProxy=HandRolled
TierLogger=Standard
# IPC routing strategy for Wind/Output TauriMainProcessService:
#   Mountain     (default) - all calls route to Mountain/Tauri IPC
#   NodeDeferred - Mountain first; miss falls through to Cocoon Node.js runtime
#   Node         - all calls bypass Mountain, go directly to Cocoon via gRPC
TierIPC=Mountain

# File system + search ------------------------------------------------------
TierFileSystem=Layer2
TierFindFiles=Layer3
TierGlob=JavaScript
# Layer4 forwards `createFileSystemWatcher` to Mountain's native `notify`-crate
# backend in Environment/FileWatcherProvider.rs (FSEvents / inotify /
# ReadDirectoryChangesW, per-handle debounce, glob-to-regex filter). `Stub`
# drops every watch registration and blinds TypeScript / ESLint / Tailwind
# (and every other LSP-driven) extension to disk mutations. Keep Layer4 as
# the default; flip to Stub only for isolation debugging.
TierFileWatcher=Layer4
# Embedded   → assets baked into binary (self-contained, slower builds)
# FileSystem  → assets served from disk (faster builds, dev-friendly)
TierSchemeAssets=FileSystem

# VS Code API surface -------------------------------------------------------
TierConfiguration=Cache
TierDiagnostics=Full
TierClipboard=Layer3
TierOpenExternal=Layer3
TierDocumentMirror=Full

# Lifecycle + concurrency ---------------------------------------------------
TierExtensionActivation=Parallel8
TierExtensionScan=Sequential
TierModuleCache=Simple

# Telemetry -----------------------------------------------------------------
TierTelemetry=Synchronous

# ===========================================================================
# Per-subsystem routing tiers (compile-time baked, runtime overridable).
# Each tier names where the dispatch arms for a given IPC subsystem run:
#   Mountain - native Rust handler (default; fastest, requires Rust impl)
#   Node     - forward every command to Cocoon via gRPC (extension-host path)
#   Disabled - boot-time off switch (currently used by TierWebSocket)
#   Process  / WebWorker - TierExtensionHost only
#
# These values are read by build.rs at compile time (baked via cargo:rustc-env),
# and re-read at runtime by mod.rs so dev overrides via shell env survive.
# When wiring a new subsystem: add the var here, EmitTierDefaults in build.rs,
# turbo.json globalEnv, and the routing arm in mod.rs.
#
# Flavor overlays in .env.Land.{RustOnly,NodeFirst,Full} set all of these at
# once. Source one via `sh Maintain/Debug/Build.sh --flavor RustOnly` or
# `set -a; . .env.Land.RustOnly; set +a` before invoking the build.
# ===========================================================================
TierTerminal=Mountain
TierSCM=Mountain
TierDebug=Mountain
TierLanguageFeatures=Mountain
TierSearch=Mountain
TierOutputChannel=Mountain
TierNativeHost=Mountain
TierTreeView=Mountain
TierStorage=Mountain
TierModel=Mountain
TierTasks=Node
TierAuth=Node
TierEncryption=Mountain
TierExtensionHost=Process
TierWebSocket=Disabled
# TierCommandEventBroadcast - opt-in dual-emit on the gRPC `Command.Execute`
# arm so `vscode.commands.onDidExecuteCommand` subscribers see commands
# invoked from extension hosts (not just from the workbench).
TierCommandEventBroadcast=Off

# Build/debug switches -------------------------------------------------------
# Disable=true  => skip ALL Output transforms (vanilla VS Code on Tauri)
# DisableUIFixes=true => skip only UI/rendering/CSS/animation transforms;
#   all wire patches, IPC, extensions, rewrites, and overlays remain active.
Disable=false
# DisableUIFixes controls CSS/rendering transforms at both Output and Sky
# build time. Uncomment to pin a value; otherwise the user's shell export
# or the default (false = apply all transforms) is used.
#DisableUIFixes=false
# Diagnostic/debug vars (Inspect, Trace, Record, Smoke, DebugServer) live
# in .env.Land.Diagnostics - source that overlay to activate them.
