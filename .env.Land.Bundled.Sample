# ===========================================================================
# Land bundled-workbench env knobs. Read by:
#   • Maintain/{Release,Debug}/Build.sh (sets BUNDLED_WORKBENCHES from the
#     selected --profile, can be overridden by sourcing this file first)
#   • Element/Sky/astro.config.ts (drives Vite's rollupOptions.input and
#     output dir for the bundled tree)
#   • Element/Output/Source/Plugin/Index.ts (gates InlineCSSImport /
#     StripCSSImport so the bundled tree is left to Vite)
#
# Copy to `.env.Land.Bundled` (gitignored) to override locally without
# editing the build profiles.
#
# Consumers (Sky, Output) treat all three values as optional - the
# default state is "no bundled workbenches"; the existing Bundle /
# Compile / Output behaviour is unchanged for every other profile.
# ===========================================================================

# Space-separated list of workbench variants to bundle through Vite.
# Valid values: electron browser sessions workbench
# Empty (default): no bundled tree is emitted.
BUNDLED_WORKBENCHES=

# When true, Mountain's Sky-redirect prefers /Bundled/<Variant> over
# the existing /Electron / /Browser / /Mountain pages.
LAND_BUNDLED_BOOT=false

# Sky output dir (relative to Sky/Target). Defaults to "Static/Bundled".
# LAND_BUNDLED_OUTPUT_DIR=Static/Bundled
