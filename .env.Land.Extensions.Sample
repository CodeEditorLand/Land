# ===========================================================================
# Land extension directory configuration. Read by:
#   • Mountain's ScanPathConfigure (directory enumeration)
#   • Mountain's VsixInstaller (install destination root)
#   • Mountain's extension scanner (user vs system classification)
#
# Copy this file to `.env.Land.Extensions` (gitignored) to override the
# default directory layout. Typical reasons to override:
#   - Shared extension cache on CI
#   - Per-workspace extension sandbox (--extensions-dir equivalent)
#   - Testing user-scoped extensions without polluting ~/.land
# ===========================================================================

# Built-in extension source (read-only, ships with Land) --------------------
# Relative to the Tauri bundle's Resources directory in production, or
# Element/Sky/Target/Static/Application/extensions in development.
# Usually does not need overriding.
#LAND_BUILTIN_EXTENSIONS_DIR=

# User extension install root ----------------------------------------------
# Where `InstallVsix` writes and where scanner enumerates user extensions.
# Default: $HOME/.land/extensions (or %APPDATA%\Land\extensions on Windows).
# VS Code equivalent: ~/.vscode/extensions.
#LAND_USER_EXTENSIONS_DIR=

# Additional extension paths (colon-separated, macOS/Linux) -----------------
# Semicolon-separated on Windows. Scanned in order; duplicates by
# publisher.name are ignored. Matches VS Code's
# `--extensions-dir=<dir1>:<dir2>` CLI flag.
#LAND_EXTRA_EXTENSIONS_DIRS=

# Development extensions root -----------------------------------------------
# Repo-local extensions under active development. Matches VS Code's
# `--extensionDevelopmentPath=<dir>` for "Extension Development Host" runs.
# Extensions here always load regardless of enablement state.
#LAND_DEV_EXTENSIONS_DIR=

# Disable built-in extensions (for extension debugging) --------------------
# When `true`, only user + dev extensions load. Matches VS Code's
# `--disable-extensions` + built-in exclusion.
#LAND_DISABLE_BUILTIN_EXTENSIONS=false

# Auto-install runtime dependencies ----------------------------------------
# When `true`, Sky's Step 13 (extension copy) runs `npm install --production`
# inside each extension with a `dependencies` field. Disable when building
# against a pre-populated node_modules cache.
LAND_AUTO_INSTALL_EXTENSION_DEPS=true
