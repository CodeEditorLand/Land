# Flavor overlay: Node — all tiers route to Cocoon (Node.js waterfall)
TierIPC=Node
TierTerminal=Node
TierSCM=Node
TierDebug=Node
TierLanguageFeatures=Node
TierSearch=Node
TierOutputChannel=Node
TierNativeHost=Node
TierTreeView=Node
TierStorage=Node
TierModel=Node
TierTasks=Node
TierAuth=Node
TierEncryption=Node
TierExtensionHost=Process
TierWebSocket=Disabled
# Node: IN-TN-AN-NN-NN-NN (IPC Node, Tasks Node, Auth Node, all Node)
ProductFlavor="INTNNNNNNN"

# Shim tier — deep-hook VS Code engine interception (experimental).
# None (default, zero overhead) | Proxy (audit) | Replace (services) | Own (engine hooks) | Preempt (full control)
TierShim=None
