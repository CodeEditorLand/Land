# ===========================================================================
# Flavor overlay: NodeFirst
# Every API surface routes to Cocoon Node.js, leaving Mountain as a thin IPC
# pass-through. Used for upstream-VS-Code feature debugging where we want to
# confirm a bug is/isn't Mountain-introduced. Slower (extra gRPC hops) but
# closer to vanilla VS Code behavior.
# ===========================================================================

TierIPC=Node
TierTerminal=Node
TierSCM=Node
TierDebug=Node
TierLanguageFeatures=Node
TierSearch=Node
TierOutputChannel=Node
TierNativeHost=Node
TierTreeView=Node
TierStorage=Node
TierModel=Node
TierTasks=Node
TierAuth=Node
TierEncryption=Node
TierExtensionHost=Process
TierWebSocket=Disabled
