# ===========================================================================
# Flavor overlay: RustOnly
# Every subsystem with a native Mountain implementation routes through Rust.
# Cocoon is still spawned for extension-host APIs that cannot be expressed in
# Rust (Node.js child_process, NPM-loaded extension code). Source from
# Maintain/Debug/Build.sh --flavor RustOnly or via `set -a; . .env.Land.RustOnly`.
# ===========================================================================

TierIPC=Mountain
TierTerminal=Mountain
TierSCM=Mountain
TierDebug=Mountain
TierLanguageFeatures=Mountain
TierSearch=Mountain
TierOutputChannel=Mountain
TierNativeHost=Mountain
TierTreeView=Mountain
TierStorage=Mountain
TierModel=Mountain
TierTasks=Mountain
TierAuth=Mountain
TierEncryption=Mountain
TierExtensionHost=Process
TierWebSocket=Disabled
