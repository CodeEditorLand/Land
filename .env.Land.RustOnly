# Flavor overlay: RustOnly — all tiers Mountain (Rust-native, no Node fallback)
TierIPC=Mountain
TierTerminal=Mountain
TierSCM=Mountain
TierDebug=Mountain
TierLanguageFeatures=Mountain
TierSearch=Mountain
TierOutputChannel=Mountain
TierNativeHost=Mountain
TierTreeView=Mountain
TierStorage=Mountain
TierModel=Mountain
TierTasks=Mountain
TierAuth=Mountain
TierEncryption=Mountain
TierExtensionHost=Process
TierWebSocket=Disabled
# RustOnly: IW-TM-AM-MM-MM-MM (IPC Mtn, Tasks Mtn, Auth Mtn, all Mtn)
ProductFlavor="IWTAMMMMMM"

# Shim tier — deep-hook VS Code engine interception (experimental).
# None (default, zero overhead) | Proxy (audit) | Replace (services) | Own (engine hooks) | Preempt (full control)
TierShim=None
