# ===========================================================================
# Flavor overlay: Full — Rust native where it exists, Mist WS, NodeDeferred IPC.
# The "ship it" flavor once Mist is stable. NodeDeferred at IPC layer so
# unknown commands still waterfall to Cocoon for standard VS Code execution.
# ===========================================================================

TierIPC=NodeDeferred
TierTerminal=Mountain
TierSCM=Mountain
TierDebug=Mountain
TierLanguageFeatures=Mountain
TierSearch=Mountain
TierOutputChannel=Mountain
TierNativeHost=Mountain
TierTreeView=Mountain
TierStorage=Mountain
TierModel=Mountain
TierTasks=Node
TierAuth=Node
TierEncryption=Mountain
TierExtensionHost=Process
TierWebSocket=Mist
# Full: ID-TN-AN-MM-MM-MM (IPC NodeDeferred, WS Mist, Tasks/Auth Node, rest Mtn)
ProductFlavor="IFTNMMMMMM"
