# ===========================================================================
# Flavor overlay: Full
# Native Rust where it exists, Mist WebSocket for high-frequency calls. The
# "ship it" flavor once the Mist server is stable. NodeDeferred at the IPC
# layer so unknown commands still fall through to Cocoon.
# ===========================================================================

TierIPC=NodeDeferred
TierTerminal=Mountain
TierSCM=Mountain
TierDebug=Mountain
TierLanguageFeatures=Mountain
TierSearch=Mountain
TierOutputChannel=Mountain
TierNativeHost=Mountain
TierTreeView=Mountain
TierStorage=Mountain
TierModel=Mountain
TierTasks=Node
TierAuth=Node
TierEncryption=Mountain
TierExtensionHost=Process
TierWebSocket=Mist
