# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
# Land Node.js runtime configuration. Read by:
#   • Mountain's NodeResolver (cocoon sidecar spawn)
#   • Mountain's CocoonManagement (env forwarding to the spawned node)
#
# Copy this file to `.env.Land.Node` (gitignored) to pin a specific Node
# binary or disable the shipped Node lookup on your machine. Operators who
# want a reproducible build environment should check the pinned version
# into their deployment config instead of relying on PATH.
# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

# Explicit Node binary override ---------------------------------------------
# Absolute path to a `node` binary. If set and the file exists, Mountain
# uses it unconditionally and skips the version-manager / PATH chain.
# Leave unset to enable automatic resolution.
#
# Example:
#   LAND_NODE_BINARY=/opt/homebrew/opt/node@22/bin/node
#   LAND_NODE_BINARY=~/.nvm/versions/node/v22.11.0/bin/node
#LAND_NODE_BINARY=

# Minimum Node major version required by Cocoon -----------------------------
# Cocoon's bundled extension host needs Node >= 20 for the stable AbortSignal
# and structuredClone surface. If resolved node reports lower, Mountain logs
# a warning but still spawns (VS Code extensions mostly still work).
LAND_NODE_MIN_MAJOR=20
